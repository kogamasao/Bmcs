@page
@model Bmcs.Pages.GameScore.EditModel


@{
    Layout = "_LayoutTailwind";
}

<div class="mx-auto max-w-6xl px-4 py-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
            <p class="mt-1 text-sm text-slate-500">@Model.Game.Team.TeamName</p>
        </div>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>
<hr />
<form method="post">

    @if (Model.Game.GameInputTypeClass == GameInputTypeClass.ByPlay)
    {
        <div class="mt-4">
            <input type="button" value="再集計する" class="js-submit inline-flex cursor-pointer items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" data-submitclass="@GameScoreSubmitClass.ReCount" />
        </div>
        <div class="mt-4">
            <a class="inline-flex cursor-pointer items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/InningScore/Index" asp-route-gameID="@Model.Game.GameID">イニング詳細</a>
        </div>
    }

    <span asp-validation-for="Game.GameID" class="mt-1 block text-sm text-red-600"></span>
    <div asp-validation-summary="ModelOnly" class="mt-1 block text-sm text-red-600"></div>
    <input type="hidden" asp-for="Game.GameID" />

    <div class="overflow-x-auto">
        <table id="inning-score" class="stat-table" style="table-layout:fixed">
            <thead>
                <tr>
                    <th style="width: 100px;" class="col-fix-left align-middle">
                        チーム名
                    </th>
                    @foreach (var inning in Model.InningScoreTopList)
                    {
                        <th style="width: 60px;" class="text-center align-middle js-title-score-th">
                            @inning.Inning
                        </th>
                    }
                    <th style="width: 60px;" class="col-fix-right text-center align-middle">
                        計
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="col-fix-left align-middle">
                        @if (Model.Game.BatFirstBatSecondClass == BatFirstBatSecondClass.First)
                        {
                            @Html.DisplayFor(model => Model.Game.Team.TeamAbbreviation)
                        }
                        else
                        {
                            @Html.DisplayFor(model => Model.Game.OpponentTeamAbbreviation)
                        }
                    </td>
                    @for (int i = 0; i < Model.InningScoreTopList.Count; i++)
                    {
                        <td id="@("InningScoreTopList_" + i.ToString())" class="text-center align-middle js-top-score-td">
                            <input class="js-rename js-top-score block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.InningScoreTopList[i].Score" min="0" />
                        </td>
                    }
                    <td class="col-fix-right text-center align-middle">
                        <span class="js-top-sum">
                            @Model.InningScoreTopList.Select(r => r.Score).Sum()
                        </span>
                    </td>
                </tr>
                <tr>
                    <td class="col-fix-left align-middle">
                        @if (Model.Game.BatFirstBatSecondClass == BatFirstBatSecondClass.First)
                        {
                            @Model.Game.OpponentTeamAbbreviation
                        }
                        else
                        {
                            @Model.Game.Team.TeamAbbreviation
                        }
                    </td>
                    @for (int i = 0; i < Model.InningScoreButtomList.Count; i++)
                    {
                        <td id="@("InningScoreButtomList_" + i.ToString())" class="text-center align-middle js-buttom-score-td">
                            <input class="js-rename js-buttom-score block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.InningScoreButtomList[i].Score" min="0" />
                        </td>
                    }
                    <td class="col-fix-right text-center align-middle">
                        <span class="js-buttom-sum">
                            @Model.InningScoreButtomList.Select(r => r.Score).Sum()
                        </span>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="mt-4">
        <input type="button" value="イニング追加" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" id="add-inning" />
        <input type="button" value="イニング削除" class="cursor-pointer rounded-md border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50" id="delete-inning" />
    </div>


    <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-2 text-sm font-bold text-slate-700">
            投手成績
        </div>
