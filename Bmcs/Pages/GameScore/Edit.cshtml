                                </td>
                                <td class="col-fix-right">
                                    <input type="button" value="削除" class="js-pitcher-delete cursor-pointer rounded-md border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-4">
                <input type="button" value="追加" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" id="add-pitcher-score" />
            </div>
        </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-200 bg-slate-50 px-4 py-2 text-sm font-bold text-slate-700">
            野手成績
        </div>
        <div class="px-4 py-3">
            <div class="overflow-x-auto">
                <table id="fielder-score" class="stat-table" style="table-layout:fixed">
                    <thead>
                        <tr>
                            <th style="width: 80px;">
