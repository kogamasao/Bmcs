                            </th>
                            <th style="width: 60px;">
                                QS
                            </th>
                            <th style="width: 60px;">
                                完投
                            </th>
                            <th style="width: 60px;">
                                完封
                            </th>
                            <th style="width: 80px;">
                                イニング
                            </th>
                            <th style="width: 80px;">
                                打席
                            </th>
                            <th style="width: 80px;">
                                打数
                            </th>
                            <th style="width: 70px;">
                                被安打
                            </th>
                            <th style="width: 80px;">
