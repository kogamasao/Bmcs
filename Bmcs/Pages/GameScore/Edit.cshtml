                                得点圏被安打
                            </th>
                            <th style="width: 70px;">
                                奪三振
                            </th>
                            <th style="width: 70px;">
                                牽制死
                            </th>
                            <th style="width: 60px;">
                                WP
                            </th>
                            <th style="width: 60px;">
