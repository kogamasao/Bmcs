                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].FourBall" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].DeadBall" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].ScoringPositionPlateAppearance" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].ScoringPositionAtBat" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].ScoringPositionHit" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].StrikeOut" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].PickOffBallOut" min="0" />
                                </td>
                                <td class="text-center align-middle">
                                    <input class="js-rename block w-full rounded-md border border-slate-300 bg-white px-1.5 py-1.5 text-sm shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" asp-for="@Model.GameScorePitcherList[i].WildPitch" min="0" />
                                </td>
                                <td class="text-center align-middle">
