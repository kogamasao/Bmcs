@page
@model Bmcs.Pages.UserAccount.IndexModel

@{
    Layout = "_LayoutTailwind";
    ViewData[ViewDataConstant.Title] = "ユーザ一覧(管理者)";
}

<div class="mx-auto max-w-6xl px-4 py-8">
<h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>

<div class="mt-6 flex flex-wrap gap-3">
    @if (Model.IsMyTeam)
    {
    <a class="inline-flex items-center justify-center rounded-lg bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800" asp-page="Create">ユーザ作成</a>
    }
    <a class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Top/Index">トップへ</a>
</div>

<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="stat-table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].UserAccountID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].UserAccountName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].Password)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].EmailAddress)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].DeleteFLG)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].TeamID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].Team.TeamName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].EntryUserID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].EntryDatetime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].UpdateUserID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UserAccount[0].UpdateDatetime)
                </th>
                <th class="col-fix-right"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.UserAccount) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserAccountID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserAccountName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Password)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EmailAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DeleteFLG)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Team.TeamID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Team.TeamName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EntryUserID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EntryDatetime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UpdateUserID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UpdateDatetime)
                </td>
                <td class="col-fix-right">
                    <div class="flex gap-1">
                    <a class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" asp-page="./Edit" asp-route-id="@item.UserAccountID">編集</a>
                    <a class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" asp-page="./Details" asp-route-id="@item.UserAccountID">詳細</a>
                    <a class="inline-flex items-center justify-center rounded-md border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50" asp-page="./Delete" asp-route-id="@item.UserAccountID">削除</a>
                    </div>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
</div>
