@page
@model Bmcs.Pages.UserAccount.ResetPasswordModel
@{
    ViewData[ViewDataConstant.Title] = "パスワードの再設定";
}

<h1 class="d-inline-block">
    @ViewData[ViewDataConstant.Title]
</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        @if (Model.IsComplete)
        {
            <div class="alert alert-success" role="alert">
                <p>パスワードを再設定しました。新しいパスワードでログインしてください。</p>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="/Index">ログイン画面へ</a>
            </div>
        }
        else if (!Model.IsValidToken)
        {
            <div class="alert alert-danger" role="alert">
                <p>
                    この再設定用URLは無効です。
                    <br />有効期限（発行から@(Bmcs.Constans.SystemConstant.ResetTokenExpireHour)時間）が切れているか、すでに使用されている可能性があります。
                    <br />お手数ですが、もう一度やり直してください。
                </p>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="./ForgotPassword">パスワード再設定をやり直す</a>
                <a class="btn btn-secondary" asp-page="/Index">ログイン画面へ</a>
            </div>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Token" />
                <div class="form-group">
                    <label asp-for="Password" class="control-label">新しいパスワード</label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="control-label">確認用パスワード</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="パスワードを再設定" class="btn btn-primary" />
                    <a class="btn btn-secondary" asp-page="/Index">戻る</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
