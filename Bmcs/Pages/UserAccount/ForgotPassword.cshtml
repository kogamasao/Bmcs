@page
@model Bmcs.Pages.UserAccount.ForgotPasswordModel
@{
    ViewData[ViewDataConstant.Title] = "パスワードをお忘れの場合";
}

<h1 class="d-inline-block">
    @ViewData[ViewDataConstant.Title]
</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        @if (Model.IsComplete)
        {
            <div class="alert alert-success" role="alert">
                <p>
                    ご登録のメールアドレスに、パスワード再設定用のURLを送信しました。
                    <br />URLの有効期限は@(Bmcs.Constans.SystemConstant.ResetTokenExpireHour)時間です。メール内のURLから新しいパスワードを設定してください。
                    <br />メールが届かない場合は、ユーザIDまたはメールアドレスが登録内容と一致していない可能性があります。
                </p>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="/Index">ログイン画面へ</a>
                <a class="btn btn-secondary" asp-page="./RecoverByTeam">メールアドレスを登録していない場合</a>
            </div>
        }
        else
        {
            <div class="alert alert-primary" role="alert">
                <p>
                    ユーザIDと、ユーザ登録時のメールアドレスを入力してください。
                    <br />両方が一致した場合、メールアドレス宛にパスワード再設定用のURLを送信します。
                </p>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="UserAccountID" class="control-label">ユーザID</label>
                    <input asp-for="UserAccountID" class="form-control" />
                    <span asp-validation-for="UserAccountID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="EmailAddress" class="control-label">メールアドレス</label>
                    <input asp-for="EmailAddress" class="form-control" />
                    <span asp-validation-for="EmailAddress" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="再設定用URLを送信" class="btn btn-primary" />
                    <a class="btn btn-secondary" asp-page="/Index">戻る</a>
                </div>
                <div class="form-group">
                    <a asp-page="./ForgotUserAccountID">ユーザIDがわからない場合</a>
                    <br />
                    <a asp-page="./RecoverByTeam">メールアドレスを登録していない場合（チーム情報で確認）</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
