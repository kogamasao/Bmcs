@page
@model Bmcs.Pages.UserAccount.ForgotPasswordModel
@{
    Layout = "_LayoutTailwind";
    ViewData[ViewDataConstant.Title] = "パスワードをお忘れの場合";
}

<div class="mx-auto max-w-xl px-4 py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>
    <div class="mt-6 space-y-5">
        @if (Model.IsComplete)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900" role="status">
                <p>
                    ご登録のメールアドレスに、パスワード再設定用のURLを送信しました。
                    <br />URLの有効期限は@(Bmcs.Constans.SystemConstant.ResetTokenExpireHour)時間です。メール内のURLから新しいパスワードを設定してください。
                    <br />メールが届かない場合は、ユーザIDまたはメールアドレスが登録内容と一致していない可能性があります。
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <a class="rounded-lg bg-sky-700 px-6 py-3 text-center text-base font-semibold text-white shadow-sm transition hover:bg-sky-800" asp-page="/Index">ログイン画面へ</a>
                <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="./RecoverByTeam">メールアドレスを登録していない場合</a>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900" role="status">
                <p>
                    ユーザIDと、ユーザ登録時のメールアドレスを入力してください。
                    <br />両方が一致した場合、メールアドレス宛にパスワード再設定用のURLを送信します。
                </p>
            </div>
            <form method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
                <div>
                    <label asp-for="UserAccountID" class="block text-sm font-semibold text-slate-800">ユーザID</label>
                    <input asp-for="UserAccountID" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <span asp-validation-for="UserAccountID" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="EmailAddress" class="block text-sm font-semibold text-slate-800">メールアドレス</label>
                    <input asp-for="EmailAddress" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <span asp-validation-for="EmailAddress" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <input type="submit" value="再設定用URLを送信" class="rounded-lg bg-emerald-700 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" />
                    <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Index">戻る</a>
                </div>
                <div>
                    <a asp-page="./ForgotUserAccountID">ユーザIDがわからない場合</a>
                    <br />
                    <a asp-page="./RecoverByTeam">メールアドレスを登録していない場合（チーム情報で確認）</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
