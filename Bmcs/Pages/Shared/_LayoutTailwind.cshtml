@*
    共通レイアウト（Tailwind CSS）。
    ※2026-09-24 に全画面の移行が完了し、旧レイアウト（Bootstrap 版の _Layout.cshtml）は削除した。
      _ViewStart の既定もこのレイアウトにしている。
*@
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* title・description・canonical・OGP・計測 *@
    @{await Html.RenderPartialAsync("_HeadMeta");}
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>

<body class="min-h-screen bg-slate-50 font-sans text-slate-800 antialiased">
    @*
        z-50：本文中の固定要素より必ず手前に出す。
        ※以前は z-30 で、成績表の左端に固定した列の見出し（app.css の .stat-table thead th.col-fix-left も z-index: 30）と同じ値だった。
          同じ値の場合は後に書かれた要素が手前になるため、スクロールすると表の見出しがメニューに重なっていた。
          本文側の固定要素（表の見出し・固定列）は z-index 30 以下とする
    *@
    <header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">
        <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
            <a class="text-xl font-bold tracking-tight text-slate-900 transition hover:text-emerald-800" asp-page="/Top/Index">Bmcs</a>

            @*
                PC用のメニュー。
                リンクは PageModelBase.GetHeaderLinkList() に1本化している
                （移行期間中、2つのレイアウトに別々に書いて片方だけ写し漏れたため）。
            *@
            <nav class="hidden flex-1 items-center gap-1 md:flex">
                @foreach (var link in Model.GetHeaderLinkList())
                {
                    <a class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 hover:text-slate-900" asp-page="@link.PageName" asp-all-route-data="@link.RouteValues">@link.Text</a>
                }
            </nav>

            <div class="ml-auto flex items-center gap-2">
                @foreach (var link in Model.GetHeaderAccountLinkList())
                {
                    @if (link.IsPrimary)
                    {
                        <a class="rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-800" asp-page="@link.PageName">@link.Text</a>
                    }
                    else
                    {
                        <a class="rounded-md px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" asp-page="@link.PageName">@link.Text</a>
                    }
                }

                @* スマートフォン用のメニュー（JavaScript不要） *@
                <details class="relative md:hidden">
                    <summary class="flex cursor-pointer items-center rounded-md p-2 text-slate-600 hover:bg-slate-100 [&::-webkit-details-marker]:hidden">
                        <span class="sr-only">メニュー</span>
                        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
                        </svg>
                    </summary>
                    <nav class="absolute right-0 z-40 mt-2 w-52 overflow-hidden rounded-lg border border-slate-200 bg-white py-1 shadow-lg">
                        @foreach (var link in Model.GetHeaderLinkList())
                        {
                            <a class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50" asp-page="@link.PageName" asp-all-route-data="@link.RouteValues">@link.Text</a>
                        }
                    </nav>
                </details>
            </div>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-6 text-sm text-slate-500">
            @* 稼働年数を示す。「2021」だけだと放置されたサービスに見えるため *@
            <span>&copy; 2021-@DateTime.Now.Year - Bmcs</span>
            <span>稼働@(DateTime.Now.Year - 2021 + 1)年目</span>
            <a class="underline underline-offset-2 hover:text-slate-800" asp-page="/Updates/Index">アップデート情報</a>
            <a class="underline underline-offset-2 hover:text-slate-800" asp-page="/Term">利用規約</a>
            <a class="underline underline-offset-2 hover:text-slate-800" asp-page="/Privacy">Privacy</a>
            <a class="underline underline-offset-2 hover:text-slate-800" asp-page="/Inquiry/Create">お問い合わせ</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
