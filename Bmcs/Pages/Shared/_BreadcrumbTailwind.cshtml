@*
    パンくず（チーム一覧 ＞ チーム名 ＞ 試合一覧 ＞ 試合結果 など）。
    PageModelBase.BreadcrumbList を表示する。最後の要素は現在の画面のため、リンクにしない。
    検索エンジン向けの構造化データ（BreadcrumbList）も同じ内容から _HeadMeta.cshtml で出力する。
*@
@model dynamic
@{
    var breadcrumbList = (List<Bmcs.PageHelper.NavigationLink>)Model.BreadcrumbList;
}
@if (breadcrumbList.Count > 0)
{
    <nav aria-label="パンくずリスト" class="mb-3">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-slate-500">
            @for (var i = 0; i < breadcrumbList.Count; i++)
            {
                var link = breadcrumbList[i];

                @if (i > 0)
                {
                    <li aria-hidden="true" class="text-slate-300">/</li>
                }

                @if (i < breadcrumbList.Count - 1)
                {
                    <li><a class="hover:text-slate-800 hover:underline" asp-page="@link.PageName" asp-all-route-data="@link.RouteValues">@link.Text</a></li>
                }
                else
                {
                    <li aria-current="page" class="max-w-[16rem] truncate font-medium text-slate-700">@link.Text</li>
                }
            }
        </ol>
    </nav>
}
