@*
    ヘルプ（Tailwind版）。

    旧 _Help.cshtml は Bootstrap の modal に依存しているため、移行済みページ用に用意する。
    <dialog> を使い、Bootstrap JS も jQuery も使わない。

    ※各項目の要点は画面内に直接書く方針とし、ここには操作手順などの詳しい説明を置く。
      モーダルはフォームを覆ってしまい、読みながら入力できないため。
*@
@model dynamic
@if (Model.SystemAdmin != null && !string.IsNullOrEmpty(Model.SystemAdmin.MessageDetail))
{
    <button type="button"
            class="js-help-open inline-flex items-center gap-1.5 rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-600 shadow-sm transition hover:bg-slate-50">
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        この画面の使い方
    </button>

    @*
        m-auto は必須。Tailwind のリセットCSSが全要素の margin を0にするため、
        <dialog> が既定で持つ中央寄せ（margin: auto）が打ち消され、左上に表示されてしまう。
    *@
    <dialog id="help-dialog" aria-labelledby="help-dialog-title" class="m-auto w-[min(48rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-900/50">
        <div class="flex items-center justify-between gap-4 border-b border-slate-200 px-5 py-4">
            <h2 id="help-dialog-title" class="text-base font-bold text-slate-900">@Model.SystemAdmin.MessageTitle</h2>
            <button type="button" class="js-help-close rounded-md p-1.5 text-slate-500 transition hover:bg-slate-100" aria-label="閉じる">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M6 18 18 6M6 6l12 12" stroke-linecap="round" />
                </svg>
            </button>
        </div>
        @* 管理者が登録したHTMLをそのまま表示する *@
        <div class="prose prose-sm prose-slate max-h-[70vh] max-w-none overflow-y-auto px-5 py-4">
            @Html.Raw(Model.SystemAdmin.MessageDetail)
        </div>
        <div class="border-t border-slate-200 px-5 py-3 text-right">
            <button type="button" class="js-help-close rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50">閉じる</button>
        </div>
    </dialog>

    <script>
        (function () {
            var dialog = document.getElementById("help-dialog");

            if (!dialog) {
                return;
            }

            document.querySelectorAll(".js-help-open").forEach(function (button) {
                button.addEventListener("click", function () { dialog.showModal(); });
            });

            dialog.querySelectorAll(".js-help-close").forEach(function (button) {
                button.addEventListener("click", function () { dialog.close(); });
            });

            //背景をクリックしたら閉じる
            dialog.addEventListener("click", function (event) {
                if (event.target === dialog) {
                    dialog.close();
                }
            });
        })();
    </script>
}
