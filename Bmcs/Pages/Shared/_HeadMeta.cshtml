@*
    head内の共通タグ（title・description・canonical・noindex・OGP・構造化データ・計測（Clarity・Google Analytics））。

    _LayoutTailwind.cshtml から読み込む。
    （移行期間中は旧レイアウトと共用するために切り出した。現在はレイアウトが1つのため、切り出したままにしている）
*@
@model dynamic
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    //検索結果・共有時のタイトル。ページで MetaTitle を設定した場合はそれを優先する（見出しは短いまま、検索結果ではチーム名などで区別する）
    var titleBase = !string.IsNullOrEmpty(Model.MetaTitle)
                    ? (string)Model.MetaTitle
                    : ViewData[ViewDataConstant.Title]?.ToString();

    var pageTitle = !string.IsNullOrEmpty(titleBase)
                    ? titleBase + " - Bmcs - 草野球・ソフトボールのスコア管理"
                    : "Bmcs - 草野球・ソフトボールのスコア管理・成績集計（無料）";

    var pageDescription = !string.IsNullOrEmpty(Model.MetaDescription)
                          ? (string)Model.MetaDescription
                          : ViewData[ViewDataConstant.Description] != null && !string.IsNullOrEmpty(ViewData[ViewDataConstant.Description].ToString())
                            ? ViewData[ViewDataConstant.Description].ToString()
                            : Bmcs.Function.SeoContent.SiteDescription;

    //共有時・canonical のURL。Hostヘッダを書き換えられても不正なURLを出さないよう、設定値を優先する
    var baseUrl = Bmcs.Function.SiteUrl.GetBaseUrl(Configuration, Context.Request);

    //検索エンジンに登録するページだけ canonical を出す（noindex のページに canonical を出すと、指示が矛盾する）
    var canonicalUrl = Model.IsIndex
                       ? baseUrl + "/" + ((string)(Model.CanonicalPath ?? Context.Request.Path.Value) ?? string.Empty).TrimStart('/')
                       : null;

    var pageUrl = canonicalUrl ?? baseUrl + Context.Request.Path + Context.Request.QueryString;

    //OGP画像。未設定の場合は画像なしのカードとして表示される
    var ogImage = Configuration.GetSection("Site")["OgImage"];

    var clarityProjectID = Configuration.GetSection("Analytics")["ClarityProjectID"];

    //Google Analytics（GA4）の測定ID。形式（G-英数字）が正しいときだけ使う（設定の誤りで script を壊さないため）
    var googleAnalyticsMeasurementID = Configuration.GetSection("Analytics")["GoogleAnalyticsMeasurementID"]?.Trim();

    if (!string.IsNullOrEmpty(googleAnalyticsMeasurementID)
        && !System.Text.RegularExpressions.Regex.IsMatch(googleAnalyticsMeasurementID, "^G-[A-Z0-9]+$"))
    {
        googleAnalyticsMeasurementID = null;
    }

    //構造化データ（JSON-LD）
    //※パンくずは画面の表示と同じ内容を BreadcrumbList として出す
    var structuredDataList = new List<object>((IEnumerable<object>)Model.StructuredDataList);
    var breadcrumbList = (List<Bmcs.PageHelper.NavigationLink>)Model.BreadcrumbList;

    if (Model.IsIndex && breadcrumbList.Count > 0)
    {
        structuredDataList.Add(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = breadcrumbList.Select((link, i) => new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = i + 1,
                ["name"] = link.Text,
                //最後の要素（現在の画面）は、canonical と同じURLにする
                ["item"] = i == breadcrumbList.Count - 1
                           ? canonicalUrl
                           : baseUrl + Url.Page(link.PageName, link.RouteValues.ToDictionary(r => r.Key, r => (object)r.Value)),
            }).ToList(),
        });
    }

    //※JavaScriptEncoder は「<」「>」「&」などを常にエスケープするため、利用者が入力したチーム名などに
    //  「</script>」が含まれていても script タグを抜け出せない。日本語はそのまま出す（エスケープすると読みにくいため）
    var jsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Create(System.Text.Unicode.UnicodeRanges.All),
    };
}
<title>@pageTitle</title>
<meta name="description" content="@pageDescription" />

@if (Model.IsIndex)
{
    <link rel="canonical" href="@canonicalUrl" />
}
else
{
    @* ログインが必要な画面・アカウント復旧・エラーなど。リンクはたどってよい（follow） *@
    <meta name="robots" content="noindex" />
}

@* SNSやLINEにURLを貼ったときの表示（設定しないとタイトルも説明も出ない） *@
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Bmcs" />
<meta property="og:locale" content="ja_JP" />
<meta property="og:title" content="@pageTitle" />
<meta property="og:description" content="@pageDescription" />
<meta property="og:url" content="@pageUrl" />
@if (!string.IsNullOrEmpty(ogImage))
{
    <meta property="og:image" content="@(baseUrl.TrimEnd('/') + "/" + ogImage.TrimStart('/'))" />
    <meta name="twitter:card" content="summary_large_image" />
}
else
{
    <meta name="twitter:card" content="summary" />
}

@foreach (var structuredData in structuredDataList)
{
    @* 「!」でタグヘルパーの対象から外す（外さないと type の「+」が「&#x2B;」にエンコードされる） *@
    <!script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(structuredData, jsonOptions))</!script>
}

@* 計測。Analytics:ClarityProjectID を設定したときだけ出力する *@
@if (!string.IsNullOrEmpty(clarityProjectID))
{
    <script>
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments) };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", "@clarityProjectID");
    </script>
}

@* 計測（Google Analytics）。Analytics:GoogleAnalyticsMeasurementID を設定したときだけ出力する *@
@if (!string.IsNullOrEmpty(googleAnalyticsMeasurementID))
{
    <script async src="https://www.googletagmanager.com/gtag/js?id=@googleAnalyticsMeasurementID"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag("js", new Date());

        //パスワード再設定のURL（?token=...）を Google に送らない
        //※メールで届く再設定用のトークンで、有効期限内は、知っていればパスワードを変更できる。
        //  表示中のページの URL と、直前のページの URL（再設定後の遷移先で参照元になる）の両方から取り除く
        (function () {
            function removeToken(url) {
                try {
                    var parsed = new URL(url);
                    parsed.searchParams.delete("token");
                    return parsed.toString();
                } catch (e) {
                    return "";
                }
            }

            gtag("config", "@googleAnalyticsMeasurementID", {
                page_location: removeToken(location.href),
                page_referrer: document.referrer ? removeToken(document.referrer) : ""
            });
        })();
    </script>
}
