@*
    アップデート情報の1件（アップデート情報の画面で使う）。
*@
@model Bmcs.Models.UpdateHistory
@using Bmcs.Enum
@{
    //区分ごとの色（新機能＝緑、改善＝青、お知らせ＝灰）
    var badgeClass = Model.UpdateHistoryClass == UpdateHistoryClass.NewFeature ? "bg-emerald-50 text-emerald-700 ring-emerald-200"
                     : Model.UpdateHistoryClass == UpdateHistoryClass.Improvement ? "bg-sky-50 text-sky-700 ring-sky-200"
                     : "bg-slate-100 text-slate-600 ring-slate-200";
}
<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex flex-wrap items-center gap-2 text-sm">
        <time class="text-slate-500" datetime="@Model.Date.ToString(Model.IsMonthOnly ? "yyyy-MM" : "yyyy-MM-dd")">@Model.DateFormat</time>
        <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 @badgeClass">@Model.UpdateHistoryClassName</span>
    </div>
    <h3 class="mt-2 font-bold text-slate-900">@Model.Title</h3>
    @if (Model.DetailList.Count > 0)
    {
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-slate-700">
            @foreach (var detail in Model.DetailList)
            {
                <li>@detail</li>
            }
        </ul>
    }
</article>
