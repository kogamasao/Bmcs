@page
@model Bmcs.Pages.Member.CreateModel

@{
    ViewData[ViewDataConstant.Title] = "メンバー追加";
    Layout = "_LayoutTailwind";

    //行のエラー（ページモデルで「MemberRowList[行番号].項目」のキーで付けている）
    string RowError(int index, string fieldName)
    {
        var entry = ViewData.ModelState[$"MemberRowList[{index}].{fieldName}"];

        return entry != null && entry.Errors.Count > 0 ? entry.Errors[0].ErrorMessage : null;
    }

    var hasError = !ViewData.ModelState.IsValid;
}

<div class="mx-auto max-w-5xl px-4 py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
            <p class="mt-1 text-sm text-slate-500">@Model.Team.TeamName</p>
        </div>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>

    @if (Model.IsTeamCreated)
    {
        @* チーム作成の直後。何をする画面かを示し、次の一歩（選手の登録）へ進んでもらう（issues.md M-7） *@
        <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900">
            <p class="font-bold">チーム「@Model.Team.TeamName」を作成しました。</p>
            <p class="mt-1">続けて、試合に出る選手を登録しましょう。チーム全員をこの画面でまとめて登録できます。</p>
        </div>
    }

    @*
        「選手」と「参加ユーザ」の違いを明示する。
        チームIDで参加したチームメイトは UserAccount として参加するだけで、
        Member（選手）は作られない。チームIDを配れば選手が増えると誤解されるため。
    *@
    <div class="mt-6 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900">
        試合に出る<strong class="font-semibold">選手は、この画面で登録します</strong>。
        <br />チームIDで参加したチームメイトは「ユーザ」としてスコア入力ができるようになりますが、選手としては登録されません。
    </div>

    <form method="post" class="js-member-create-form mt-6">
        @if (hasError)
        {
            <div asp-validation-summary="ModelOnly" class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
            @if (ViewData.ModelState.Keys.Any(r => r.StartsWith("MemberRowList[")))
            {
                <p class="mb-4 rounded-md bg-red-50 p-3 text-sm text-red-700">入力内容に誤りがあります。赤枠の項目を確認してください。</p>
            }
        }
        <input type="hidden" asp-for="TeamID" />

        <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
            <p class="text-sm text-slate-600">
                1行に1人ずつ入力します。<strong class="font-semibold text-slate-800">入力が必要なのは名前だけ</strong>で、
                背番号・区分・投・打・ポジションは任意です（あとから変更できます）。名前も背番号も空の行は登録されません。
            </p>

            @* 見出し（PCのみ。スマートフォンでは各項目の上に表示する） *@
            <div class="mt-4 hidden grid-cols-[4.5rem_minmax(0,1fr)_7.5rem_5.5rem_5.5rem_7.5rem_2.5rem] gap-2 border-b border-slate-200 pb-2 text-xs font-semibold text-slate-500 sm:grid">
                <span>背番号</span>
                <span>名前<span class="ml-1 text-red-600">*</span></span>
                <span>区分</span>
                <span>投</span>
                <span>打</span>
                <span>ポジション</span>
                <span class="sr-only">削除</span>
            </div>

            <div class="js-member-rows" data-max-row-count="@Bmcs.Pages.Member.CreateModel.MaxRowCount">
                @for (var i = 0; i < Model.MemberRowList.Count; i++)
                {
                    @await Html.PartialAsync("_MemberCreateRow", new Bmcs.Pages.Member.MemberCreateRowView
                    {
                        Index = i.ToString(),
                        Row = Model.MemberRowList[i],
                        UniformNumberError = RowError(i, "UniformNumber"),
                        MemberNameError = RowError(i, "MemberName"),
                    })
                }
            </div>

            @* 行のひな形（行を追加するときに複製する） *@
            <template class="js-member-row-template">
                @await Html.PartialAsync("_MemberCreateRow", new Bmcs.Pages.Member.MemberCreateRowView
                {
                    Index = "__index__",
                    Row = new Bmcs.Pages.Member.CreateModel.MemberRow(),
                })
            </template>

            <div class="mt-4 flex flex-wrap items-center gap-3">
                <button type="button" class="js-member-row-add inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50" data-add-row-count="@Bmcs.Pages.Member.CreateModel.AddRowCount">
                    ＋ @(Bmcs.Pages.Member.CreateModel.AddRowCount)人分の行を追加
                </button>
                <span class="text-xs text-slate-500">1回に@(Bmcs.Pages.Member.CreateModel.MaxRowCount)人まで登録できます。</span>
            </div>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <button type="submit" class="js-member-submit rounded-lg bg-emerald-700 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
                <span class="js-member-submit-label">登録する</span>
            </button>
            <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="Index" asp-route-teamID="@Model.Team.TeamID">メンバー一覧へ</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/member-create.js" asp-append-version="true"></script>
}
