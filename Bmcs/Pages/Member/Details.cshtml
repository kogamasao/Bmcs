@page
@model Bmcs.Pages.Member.DetailsModel

@{
    ViewData[ViewDataConstant.Title] = "メンバー情報";
    Layout = "_LayoutTailwind";
}

<div class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
            <p class="mt-1 text-sm text-slate-500">@Model.Member.Team.TeamName</p>
        </div>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>

    <dl class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.UniformNumber)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.UniformNumber)</dd>
            </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.MemberName)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.MemberName)</dd>
            </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.MemberClassName)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.MemberClassName)</dd>
            </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.ThrowClassName)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.ThrowClassName)</dd>
            </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.BatClassName)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.BatClassName)</dd>
            </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.PositionGroupClassName)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.PositionGroupClassName)</dd>
            </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.MessageDetail)</dt>
                <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.MessageDetail)</dd>
            </div>
        @if (Model.IsAdmin())
        {
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                    <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.EntryUserID)</dt>
                    <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.EntryUserID)</dd>
                </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                    <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.EntryDatetime)</dt>
                    <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.EntryDatetime)</dd>
                </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                    <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.UpdateUserID)</dt>
                    <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.UpdateUserID)</dd>
                </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                    <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Member.UpdateDatetime)</dt>
                    <dd class="whitespace-pre-line text-slate-900">@Html.DisplayFor(model => model.Member.UpdateDatetime)</dd>
                </div>
        }
