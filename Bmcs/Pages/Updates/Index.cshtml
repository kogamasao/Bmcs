@page
@model Bmcs.Pages.Updates.IndexModel
@using Bmcs.Enum
@{
    ViewData[ViewDataConstant.Title] = "アップデート情報";
    Layout = "_LayoutTailwind";
}

<div class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
    <p class="mt-2 text-sm text-slate-600">Bmcs に追加した機能や、改善した点をお知らせします。</p>

    @foreach (var yearGroup in Model.UpdateHistoryList.GroupBy(r => r.Date.Year))
    {
        <section class="mt-10">
            <h2 class="border-b border-slate-200 pb-2 text-lg font-bold text-slate-900">@(yearGroup.Key)年</h2>

            <div class="mt-4 space-y-4">
                @foreach (var item in yearGroup)
                {
                    @await Html.PartialAsync("~/Pages/Shared/_UpdateHistoryItemTailwind.cshtml", item)
                }
            </div>
        </section>
    }
</div>
