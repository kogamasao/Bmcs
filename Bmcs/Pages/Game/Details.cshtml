@page
@model Bmcs.Pages.Game.DetailsModel

@{
    ViewData[ViewDataConstant.Title] = "試合情報詳細";
    Layout = "_LayoutTailwind";
}

<div class="mx-auto max-w-6xl px-4 py-8">
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
        <p class="mt-1 text-sm text-slate-500">@Model.Game.Team.TeamName</p>
    </div>

    <dl class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.GameDate)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Model.Game.GameDateFormat</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.GameClass)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Model.Game.GameClassName</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.OpponentTeamName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.OpponentTeamName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.OpponentTeamAbbreviation)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.OpponentTeamAbbreviation)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.StadiumName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.StadiumName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.WeatherClassName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.WeatherClassName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.WinLoseClassName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.WinLoseClassName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.GameScore)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.GameScore)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.BatFirstBatSecondClassName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.BatFirstBatSecondClassName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.GameInputTypeClassName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.GameInputTypeClassName)</dd>
        </div>
        @if (Model.IsAdmin())
        {
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.StatusClass)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.StatusClass)</dd>
            </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.DeleteFLG)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.DeleteFLG)</dd>
            </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.EntryUserID)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.EntryUserID)</dd>
            </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.EntryDatetime)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.EntryDatetime)</dd>
            </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.UpdateUserID)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.UpdateUserID)</dd>
            </div>
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Game.UpdateDatetime)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Game.UpdateDatetime)</dd>
            </div>
        }
    </dl>

    <div class="mt-6">
        <a class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="./Index" asp-route-teamID="@Model.Game.Team.TeamID">試合一覧へ</a>
    </div>
</div>
