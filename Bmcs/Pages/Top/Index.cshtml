@page
@model Bmcs.Pages.Top.IndexModel
@using Bmcs.Constans;
@{
    if (Model.MyTeam != null)
    {
        ViewData[ViewDataConstant.Title] = Model.MyTeam.TeamName;
    }

    Layout = "_LayoutTailwind";

    //見出しはチーム名を優先する（チーム未所属・未ログインの場合の表示も用意する）
    var heading = Model.MyTeam != null
                  ? Model.MyTeam.TeamName
                  : (Model.IsLogin() ? "マイページ" : "Bmcs");
}

<div class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@heading</h1>

    @if (Model.UnansweredSurvey != null)
    {
        @* 未回答のアンケートがある場合のみ表示する（回答するとこの案内は出なくなる） *@
        <div class="mt-6 rounded-xl border border-sky-200 bg-sky-50 p-5">
            <p class="font-bold text-sky-900">@Model.UnansweredSurvey.SurveyTitle</p>
            <p class="mt-1 text-sm text-sky-900/80">今後の改善のため、ご意見をお聞かせください。（選択式・1分程度）</p>
            <a class="mt-4 inline-flex items-center justify-center rounded-lg bg-sky-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-800" asp-page="/Survey/Answer">
                アンケートに回答する
            </a>
        </div>
    }

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_22rem]">
        <div class="space-y-10">
            @if (!Model.IsLogin())
            {
                <div class="rounded-xl border border-amber-200 bg-amber-50 p-6">
                    <h2 class="font-bold text-amber-900">未ログインでは機能が制限されます</h2>
                    <p class="mt-1 text-sm text-amber-900/80">公開チームの閲覧のみご利用いただけます。</p>
                    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
                        <a class="inline-flex items-center justify-center rounded-lg bg-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-800" asp-page="/Index">
                            ログイン画面へ
                        </a>
                        <a class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/UserAccount/Create">
                            無料でユーザ登録
                        </a>
                    </div>
                </div>
            }
            else
            {
                <section>
                    <h2 class="text-lg font-bold text-slate-900">スコア入力＆成績管理</h2>
                    <p class="mt-1 text-sm text-slate-600">
                        メンバーページで選手を登録したあと、試合ページからスコアを入力し、最後に「確定する」を押すと、成績ページで結果を確認できます。
                    </p>

                    <div class="mt-5 grid gap-4 sm:grid-cols-2">
                        <a class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Game/Index">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-700">
                                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>
                                <span class="block font-bold text-slate-900 group-hover:text-sky-800">試合</span>
                                <span class="mt-0.5 block text-sm text-slate-600">試合の登録とスコア入力</span>
                            </span>
                        </a>

                        <a class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Score/Index" asp-route-scorePageClass="@ScorePageClass.Index" asp-route-isPublic="@false">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-700">
                                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>
                                <span class="block font-bold text-slate-900 group-hover:text-sky-800">成績</span>
                                <span class="mt-0.5 block text-sm text-slate-600">チーム成績・個人成績の確認</span>
                            </span>
                        </a>

                        <a class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Member/Index">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700">
                                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>
                                <span class="block font-bold text-slate-900 group-hover:text-sky-800">メンバー</span>
                                <span class="mt-0.5 block text-sm text-slate-600">選手の登録・編集</span>
                            </span>
                        </a>

                        <a class="group flex items-start gap-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Team/Edit">
                            <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-700">
                                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                                    <path d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.03 7.03 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" stroke-linecap="round" stroke-linejoin="round" />
                                    <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </span>
                            <span>
                                <span class="block font-bold text-slate-900 group-hover:text-sky-800">チーム情報変更</span>
                                <span class="mt-0.5 block text-sm text-slate-600">チーム設定・公開設定</span>
                            </span>
                        </a>
                    </div>
                </section>
            }

            <section>
                <h2 class="text-lg font-bold text-slate-900">公開チームをチェック</h2>
                <p class="mt-1 text-sm text-slate-600">
                    公開されているチームの情報を確認できます。メッセージを送って、他チームと連絡を取り合うこともできます。
                </p>

                <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    <a class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Team/Index">
                        <span class="block font-bold text-slate-900 group-hover:text-sky-800">公開チーム</span>
                        <span class="mt-0.5 block text-sm text-slate-600">チームの一覧と詳細</span>
                    </a>
                    <a class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Score/Index" asp-route-scorePageClass="@ScorePageClass.Index" asp-route-isPublic="@true">
                        <span class="block font-bold text-slate-900 group-hover:text-sky-800">公開チーム成績</span>
                        <span class="mt-0.5 block text-sm text-slate-600">他チームの成績を見る</span>
                    </a>
                    <a class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow-md" asp-page="/Message/Index" asp-route-messagePageClass="@MessagePageClass.Public">
                        <span class="block font-bold text-slate-900 group-hover:text-sky-800">メッセージ</span>
                        <span class="mt-0.5 block text-sm text-slate-600">公開・ダイレクトメッセージ</span>
                    </a>
                </div>
            </section>
        </div>

        <aside class="space-y-6">
            @if (Model.SystemAdmin != null && !string.IsNullOrEmpty(Model.SystemAdmin.MessageDetail))
            {
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <h2 class="border-b border-slate-200 bg-slate-800 px-5 py-3 text-sm font-bold text-white">お知らせ</h2>
                    @* 管理者が登録した内容のため、HTMLとして表示する *@
                    <div class="px-5 py-4 text-sm leading-relaxed text-slate-700">
                        @Html.Raw(Model.SystemAdmin.MessageDetail)
                    </div>
                </div>
            }

            @if (Model.PublicMessage != null)
            {
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <h2 class="border-b border-slate-200 bg-slate-100 px-5 py-3 text-sm font-bold text-slate-700">最新の公開メッセージ</h2>
                    <div class="px-5 py-4">
                        <p class="font-bold text-slate-900">@Model.PublicMessage.MessageTitle</p>
                        <p class="mt-1 text-sm text-slate-500">
                            <a class="text-sky-700 underline underline-offset-2 hover:text-sky-800" asp-page="/Team/Details" asp-route-id="@Model.PublicMessage.TeamID">@Model.PublicMessage.Team.TeamName</a>
                            <span class="mx-1">：</span>
                            <span>@Model.PublicMessage.UserAccount.UserAccountName</span>
                        </p>
                        <div class="mt-3 text-sm leading-relaxed text-slate-700">
                            @Html.Raw(Model.PublicMessage.MessageDetail.ReplaceNewLineForHtml())
                        </div>
                        <dl class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
                            <div><dt class="inline">更新日時：</dt><dd class="inline">@Model.PublicMessage.UpdateDatetimeFormat</dd></div>
                            <div><dt class="inline">返信件数：</dt><dd class="inline">@Model.PublicMessage.ReplyCount 件</dd></div>
                        </dl>
                        <a class="mt-4 inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Message/Index" asp-route-messagePageClass="@MessagePageClass.Public" asp-route-messageID="@Model.PublicMessage.MessageID">
                            確認＆返信
                        </a>
                    </div>
                </div>
            }

            @if (Model.PrivateMessage != null)
            {
                <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                    <h2 class="border-b border-slate-200 bg-slate-100 px-5 py-3 text-sm font-bold text-slate-700">最新の非公開メッセージ</h2>
                    <div class="px-5 py-4">
                        <p class="font-bold text-slate-900">@Model.PrivateMessage.MessageTitle</p>
                        <p class="mt-1 text-sm text-slate-500">
                            <a class="text-sky-700 underline underline-offset-2 hover:text-sky-800" asp-page="/Team/Details" asp-route-id="@Model.PrivateMessage.TeamID">@Model.PrivateMessage.Team.TeamName</a>
                            <span class="mx-1">：</span>
                            <span>@Model.PrivateMessage.UserAccount.UserAccountName</span>
                        </p>
                        <div class="mt-3 text-sm leading-relaxed text-slate-700">
                            @Html.Raw(Model.PrivateMessage.MessageDetail.ReplaceNewLineForHtml())
                        </div>
                        <dl class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
                            <div><dt class="inline">更新日時：</dt><dd class="inline">@Model.PrivateMessage.UpdateDatetimeFormat</dd></div>
                            <div><dt class="inline">返信件数：</dt><dd class="inline">@Model.PrivateMessage.ReplyCount 件</dd></div>
                        </dl>
                        <a class="mt-4 inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Message/Index" asp-route-messagePageClass="@MessagePageClass.Private" asp-route-messageID="@Model.PrivateMessage.MessageID">
                            確認＆返信
                        </a>
                    </div>
                </div>
            }
        </aside>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
