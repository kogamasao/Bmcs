@page
@model Bmcs.Pages.Team.DetailsModel

@{
    ViewData[ViewDataConstant.Title] = "チーム情報";
    Layout = "_LayoutTailwind";

    var secondaryButton = "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50";
}

<div class="mx-auto max-w-6xl px-4 py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
            <p class="mt-1 text-sm text-slate-500">@Model.Team.TeamName</p>
        </div>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>

    @* このチームの各ページへ。以前はページ最下部（成績表の下）にあった *@
    <div class="mt-4 flex flex-wrap gap-2">
        <a class="@secondaryButton" asp-page="/Game/Index" asp-route-teamID="@Model.Team.TeamID">試合</a>
        <a class="@secondaryButton" asp-page="/Score/Index" asp-route-scorePageClass="@ScorePageClass.Index" asp-route-teamID="@Model.Team.TeamID" asp-route-isPublic="@true" asp-route-teamCategoryClass="@TeamCategoryClass.All" asp-route-useBallClass="@UseBallClass.All">成績</a>
        <a class="@secondaryButton" asp-page="/Member/Index" asp-route-teamID="@Model.Team.TeamID">メンバー</a>
        @if (Model.MyTeam != null && Model.MyTeam.PublicFLG && Model.MyTeam.TeamID != Model.Team.TeamID)
        {
            <a class="@secondaryButton" asp-page="/Message/Index" asp-route-messagePageClass="@MessagePageClass.Public" asp-route-privateTeamID="@Model.Team.TeamID">メッセージを送る</a>
        }
    </div>
    <dl class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.TeamName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.TeamName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.TeamAbbreviation)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.TeamAbbreviation)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.RepresentativeName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.RepresentativeName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.TeamCategoryClassName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.TeamCategoryClassName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.UseBallClassName)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.UseBallClassName)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.ActivityBase)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.ActivityBase)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.TeamNumber)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.TeamNumber)</dd>
        </div>
        @* メールアドレスは自チーム（と管理者）にだけ表示する。他チームには公開しない *@
        @if (Model.IsMyTeamData(Model.Team.TeamID))
        {
            <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.TeamEmailAddress)</dt>
                <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.TeamEmailAddress)</dd>
            </div>
        }
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Team.MessageDetail)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Team.MessageDetail)</dd>
        </div>
    </dl>

    @if (Model.GameScoreTeamList.Any())
    {
        <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
            <div class="border-b border-slate-200 bg-slate-50 px-4 py-2 text-sm font-bold text-slate-700">
                チーム成績
            </div>
            <div class="px-4 py-3">
                <div class="overflow-x-auto">
                    <table class="stat-table">
                        <thead>
                            <tr>
                                <th class="col-fix-left">
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Year)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].GameCount)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].WinRate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Win)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Lose)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Draw)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].BattingAverage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Hit)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].DoubleHit)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].TripleHit)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].HomeRun)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].RBI)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Run)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].StolenBaseSuccessRate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].StolenBase)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].FourBall)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].DeadBall)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Sacrifice)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].SacrificeFly)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].LeftOnBase)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].OnBasePercentage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].SluggingPercentage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Ops)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].ScoringPositionBattingAverage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].StrikeOut)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].StopStolenBaseRate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].StopStolenBase)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].OwnError)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].EarnedRunAverage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].QualityStartRate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherBattingAverage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherHit)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherHomeRun)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherRun)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherEarnedRun)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherFourBall)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherDeadBall)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].Whip)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherScoringPositionBattingAverage)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherStrikeOutRate)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherStrikeOut)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.GameScoreTeamList[0].PitcherStrikeOutBaseOnBallsRate)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.GameScoreTeamList.OrderBy(r => r.Year))
                            {
                                <tr>
                                    <td class="col-fix-left">
                                        @Html.DisplayFor(modelItem => item.Year)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.GameCount)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.WinRateFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.Win)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.Lose)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.Draw)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.BattingAverageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.Hit)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.DoubleHit)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.TripleHit)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.HomeRun)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.RBI)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.Run)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.StolenBaseSuccessRateFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.StolenBase)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.FourBall)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.DeadBall)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.Sacrifice)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.SacrificeFly)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.LeftOnBase)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.OnBasePercentageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.SluggingPercentageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.OpsFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.ScoringPositionBattingAverageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.StrikeOut)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.StopStolenBaseRateFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.StopStolenBase)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.OwnError)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.EarnedRunAverageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.QualityStartRateFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherBattingAverageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherHit)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherHomeRun)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherRun)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherEarnedRun)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherFourBall)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherDeadBall)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.WhipFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherScoringPositionBattingAverageFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherStrikeOutRateFormat)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherStrikeOut)
                                    </td>
                                    <td class="text-center align-middle">
                                        @Html.DisplayFor(modelItem => item.PitcherStrikeOutBaseOnBallsRateFormat)
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }


    <div class="mt-6">
        <a class="@secondaryButton" asp-page="./Index">チーム一覧へ</a>
    </div>
</div>
