@page
@model Bmcs.Pages.Team.ResetTeamPasswordModel
@{
    ViewData[ViewDataConstant.Title] = "チームパスワードの再設定";
}

<h1 class="d-inline-block">
    @ViewData[ViewDataConstant.Title]
</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        @if (Model.IsComplete)
        {
            <div class="alert alert-success" role="alert">
                <p>
                    チームパスワードを再設定しました。
                    <br />チームメンバーがチームに参加する際は、新しいチームパスワードをお伝えください。
                </p>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="/Index">ログイン画面へ</a>
            </div>
        }
        else if (!Model.IsValidToken)
        {
            <div class="alert alert-danger" role="alert">
                <p>
                    この再設定用URLは無効です。
                    <br />有効期限（発行から@(Bmcs.Constans.SystemConstant.ResetTokenExpireHour)時間）が切れているか、すでに使用されている可能性があります。
                    <br />お手数ですが、もう一度やり直してください。
                </p>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="./ForgotTeamPassword">チームパスワード再設定をやり直す</a>
                <a class="btn btn-secondary" asp-page="/Index">ログイン画面へ</a>
            </div>
        }
        else
        {
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Token" />
                <div class="form-group">
                    <label asp-for="TeamPassword" class="control-label">新しいチームパスワード</label>
                    <input asp-for="TeamPassword" type="password" class="form-control" />
                    <span asp-validation-for="TeamPassword" class="text-danger"></span>
                    <small class="form-text text-muted">
                        ※チームパスワードは、メンバーがチームに参加する際に使用します。
                        推測されにくい文字列を設定してください。
                    </small>
                </div>
                <div class="form-group">
                    <label asp-for="ConfirmTeamPassword" class="control-label">確認用チームパスワード</label>
                    <input asp-for="ConfirmTeamPassword" type="password" class="form-control" />
                    <span asp-validation-for="ConfirmTeamPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="チームパスワードを再設定" class="btn btn-primary" />
                    <a class="btn btn-secondary" asp-page="/Index">戻る</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
