@page
@model Bmcs.Pages.Team.ResetTeamPasswordModel
@{
    Layout = "_LayoutTailwind";
    ViewData[ViewDataConstant.Title] = "チームパスワードの再設定";
}

<div class="mx-auto max-w-xl px-4 py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>
    <div class="mt-6 space-y-5">
        @if (Model.IsComplete)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900" role="status">
                <p>
                    チームパスワードを再設定しました。
                    <br />チームメンバーがチームに参加する際は、新しいチームパスワードをお伝えください。
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <a class="rounded-lg bg-sky-700 px-6 py-3 text-center text-base font-semibold text-white shadow-sm transition hover:bg-sky-800" asp-page="/Index">ログイン画面へ</a>
            </div>
        }
        else if (!Model.IsValidToken)
        {
            <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900" role="alert">
                <p>
                    この再設定用URLは無効です。
                    <br />有効期限（発行から@(Bmcs.Constans.SystemConstant.ResetTokenExpireHour)時間）が切れているか、すでに使用されている可能性があります。
                    <br />お手数ですが、もう一度やり直してください。
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <a class="rounded-lg bg-sky-700 px-6 py-3 text-center text-base font-semibold text-white shadow-sm transition hover:bg-sky-800" asp-page="./ForgotTeamPassword">チームパスワード再設定をやり直す</a>
                <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Index">ログイン画面へ</a>
            </div>
        }
        else
        {
            <form method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
                <input type="hidden" asp-for="Token" />
                <div>
                    <label asp-for="TeamPassword" class="block text-sm font-semibold text-slate-800">新しいチームパスワード</label>
                    <input asp-for="TeamPassword" type="password" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <span asp-validation-for="TeamPassword" class="mt-1 block text-sm text-red-600"></span>
                    <p class="mt-1 text-sm text-slate-500">
                        ※チームパスワードは、メンバーがチームに参加する際に使用します。
                        推測されにくい文字列を設定してください。
                    </p>
                </div>
                <div>
                    <label asp-for="ConfirmTeamPassword" class="block text-sm font-semibold text-slate-800">確認用チームパスワード</label>
                    <input asp-for="ConfirmTeamPassword" type="password" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <span asp-validation-for="ConfirmTeamPassword" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <input type="submit" value="チームパスワードを再設定" class="rounded-lg bg-emerald-700 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" />
                    <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Index">戻る</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
