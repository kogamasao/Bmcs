@page
@model Bmcs.Pages.Team.ForgotTeamPasswordModel
@{
    Layout = "_LayoutTailwind";
    ViewData[ViewDataConstant.Title] = "チームパスワードをお忘れの場合";
}

<div class="mx-auto max-w-xl px-4 py-8">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>
        @await Html.PartialAsync("~/Pages/Shared/_HelpTailwind.cshtml")
    </div>
    <div class="mt-6 space-y-5">
        @if (Model.IsComplete)
        {
            <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-900" role="status">
                <p>
                    チームに登録されているメールアドレス宛に、チームパスワード再設定用のURLを送信しました。
                    <br />メールが届かない場合は、チームIDまたはメールアドレスが登録内容と一致していない可能性があります。
                </p>
            </div>
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                <a class="rounded-lg bg-sky-700 px-6 py-3 text-center text-base font-semibold text-white shadow-sm transition hover:bg-sky-800" asp-page="/Index">ログイン画面へ</a>
                <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Inquiry/Create">お問い合わせ</a>
            </div>
        }
        else
        {
            <div class="rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-sky-900" role="status">
                <p>
                    チームIDと、チームに登録しているメールアドレスを入力してください。
                    <br />両方が一致した場合、チームパスワード再設定用のURLをメールで送信します。
                </p>
            </div>
            <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" role="status">
                <p>
                    ※チームにログインできる方がいる場合は、メールを使わずにチーム編集画面から変更できます。
                    <br />※チームにメールアドレスを登録していない場合は、お問い合わせページよりご連絡ください。
                </p>
            </div>
            <form method="post" class="space-y-5">
                <div asp-validation-summary="ModelOnly" class="rounded-md bg-red-50 p-3 text-sm text-red-700"></div>
                <div>
                    <label asp-for="TeamID" class="block text-sm font-semibold text-slate-800">チームID</label>
                    <input asp-for="TeamID" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <span asp-validation-for="TeamID" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div>
                    <label asp-for="TeamEmailAddress" class="block text-sm font-semibold text-slate-800">チームのメールアドレス</label>
                    <input asp-for="TeamEmailAddress" class="mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2.5 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" />
                    <span asp-validation-for="TeamEmailAddress" class="mt-1 block text-sm text-red-600"></span>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
                    <input type="submit" value="再設定用URLを送信" class="rounded-lg bg-emerald-700 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-emerald-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2" />
                    <a class="rounded-lg border border-slate-300 bg-white px-6 py-3 text-center text-base font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Index">戻る</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
