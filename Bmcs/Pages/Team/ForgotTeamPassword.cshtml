@page
@model Bmcs.Pages.Team.ForgotTeamPasswordModel
@{
    ViewData[ViewDataConstant.Title] = "チームパスワードをお忘れの場合";
}

<h1 class="d-inline-block">
    @ViewData[ViewDataConstant.Title]
</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        @if (Model.IsComplete)
        {
            <div class="alert alert-success" role="alert">
                <p>
                    チームに登録されているメールアドレス宛に、チームパスワード再設定用のURLを送信しました。
                    <br />メールが届かない場合は、チームIDまたはメールアドレスが登録内容と一致していない可能性があります。
                </p>
            </div>
            <div class="form-group">
                <a class="btn btn-primary" asp-page="/Index">ログイン画面へ</a>
                <a class="btn btn-secondary" asp-page="/Inquiry/Create">お問い合わせ</a>
            </div>
        }
        else
        {
            <div class="alert alert-primary" role="alert">
                <p>
                    チームIDと、チームに登録しているメールアドレスを入力してください。
                    <br />両方が一致した場合、チームパスワード再設定用のURLをメールで送信します。
                </p>
            </div>
            <div class="alert alert-warning" role="alert">
                <p>
                    ※チームにログインできる方がいる場合は、メールを使わずにチーム編集画面から変更できます。
                    <br />※チームにメールアドレスを登録していない場合は、お問い合わせページよりご連絡ください。
                </p>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="TeamID" class="control-label">チームID</label>
                    <input asp-for="TeamID" class="form-control" />
                    <span asp-validation-for="TeamID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="TeamEmailAddress" class="control-label">チームのメールアドレス</label>
                    <input asp-for="TeamEmailAddress" class="form-control" />
                    <span asp-validation-for="TeamEmailAddress" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="再設定用URLを送信" class="btn btn-primary" />
                    <a class="btn btn-secondary" asp-page="/Index">戻る</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
