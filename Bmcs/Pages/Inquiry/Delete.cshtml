@page
@model Bmcs.Pages.Inquiry.DeleteModel

@{
    Layout = "_LayoutTailwind";
    ViewData[ViewDataConstant.Title] = "お問い合わせ削除(管理者)";
}

<div class="mx-auto max-w-3xl px-4 py-8">
<h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>

<div class="mt-6 rounded-xl border border-red-200 bg-red-50 p-5">
    <h2 class="font-bold text-red-900">お問い合わせを削除します。よろしいですか？</h2>
</div>
<div>
    <dl class="mt-6 divide-y divide-slate-100 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Inquiry.EmailAddress)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Inquiry.EmailAddress)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Inquiry.InquiryTitle)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Inquiry.InquiryTitle)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Inquiry.InquiryDetail)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Inquiry.InquiryDetail)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Inquiry.ReplyFLG)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Inquiry.ReplyFLG)</dd>
        </div>
        <div class="grid gap-1 px-5 py-3 sm:grid-cols-[10rem_1fr] sm:gap-4">
            <dt class="text-sm font-semibold text-slate-500">@Html.DisplayNameFor(model => model.Inquiry.CompleteFLG)</dt>
            <dd class="whitespace-pre-line break-words text-slate-900">@Html.DisplayFor(model => model.Inquiry.CompleteFLG)</dd>
        </div>
    </dl>

    <form method="post" class="mt-8 flex flex-wrap gap-3">
        <input type="hidden" asp-for="Inquiry.InquiryID" />
        <input type="submit" value="削除する" class="rounded-lg bg-red-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition hover:bg-red-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2" />
        <a class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="./Index">一覧へ</a>
    </form>
</div>
</div>
