@page
@model Bmcs.Pages.Inquiry.IndexModel

@{
    Layout = "_LayoutTailwind";
    ViewData[ViewDataConstant.Title] = "お問い合わせ一覧(管理者)";
}

<div class="mx-auto max-w-6xl px-4 py-8">
<h1 class="text-2xl font-bold tracking-tight text-slate-900">@ViewData[ViewDataConstant.Title]</h1>

<div class="mt-6 flex flex-wrap gap-3">
    <a class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:bg-slate-50" asp-page="/Top/Index">トップへ</a>
</div>

<div class="mt-6 overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="stat-table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].EmailAddress)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].InquiryTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].InquiryDetail)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].ReplyFLG)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].CompleteFLG)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].EntryUserID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Inquiry[0].EntryDatetime)
                </th>
                <th class="col-fix-right"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Inquiry)
            {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.EmailAddress)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InquiryTitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InquiryDetail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ReplyFLG)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CompleteFLG)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EntryUserID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.EntryDatetime)
                </td>
                <td class="col-fix-right">
                    <div class="flex gap-1">
                    <a class="inline-flex items-center justify-center rounded-md border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50" asp-page="./Details" asp-route-id="@item.InquiryID">詳細</a>
                    <a class="inline-flex items-center justify-center rounded-md border border-red-300 bg-white px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50" asp-page="./Delete" asp-route-id="@item.InquiryID">削除</a>
                    </div>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>
</div>
